<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Parametric3D — приложение на Avalonia 12 (решение пользователя 2026-10-11, UI_AVALONIA_STAGE.md).
    Сборка включает ядро (Kernel), модель (Model), общее (Core), рендер (Render) и оболочку (App) —
    все *.cs под этой папкой, кроме документации.

    Пакеты: обычная сборка берёт их с nuget.org. Сборка без сети (среда разработки ядра):
      dotnet build -p:LocalDeps=<tools/deps> -p:UiPackages=<каталог .nupkg Avalonia>
    тогда OpenTK.Mathematics и System.Drawing.Common — проекты из tools/deps, а Avalonia — из локального каталога.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- C# 12 (язык .NET 8) и в новых Visual Studio: в C# 14 у массивов arr.Reverse() — уже Span.Reverse (void, на месте),
         и код, верный в C# 12, перестаёт собираться или меняет смысл. Так то, что проверено здесь, собирается и у пользователя. -->
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- k126: без профилирования по ходу работы (TieredPGO): первый расчёт детали — на 20 % быстрее (код ядра реже уходит
         в медленный уровень с замерами), установившийся — не медленнее, запуск окна — тот же (замер на детали пользователя). -->
    <TieredPGO>false</TieredPGO>
    <RootNamespace>Parametric3D</RootNamespace>
    <AssemblyName>Parametric3D</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="Exists('App\Assets\Icons\app_icon.ico')">App\Assets\Icons\app_icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Генераторы Avalonia 12 просят Roslyn 4.14; у .NET 8 SDK — 4.8: компиляция XAML при этом работает. -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <!-- Генератор полей x:Name требует Roslyn 4.14 (нет в .NET 8 SDK): поля находятся вручную (*.Names.cs). -->
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
    <!-- 20:17 (скорость): код оптимизируется и в отладочной сборке (Debug) — ядро без оптимизации медленнее в разы, а
         приложение обычно запускают из Visual Studio как есть. Отладка шагами по ядру — Release не нужен: переменные,
         убранные оптимизатором, видны хуже, но точки останова работают. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UiPackages)'!=''">
    <RestoreSources>$(UiPackages)</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="docs/**" />
    <None Remove="docs/**" />
    <AvaloniaResource Include="App/Assets/**" />
    <!-- шрифт текста в окне вида (ГОСТ тип А): ещё и как встроенный ресурс — для штрихового текста размеров (Render.GostFont) -->
    <EmbeddedResource Include="App/Assets/Fonts/GOST_A.TTF" LogicalName="GOST_A.TTF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalDeps)'!=''">
    <ProjectReference Include="$(LocalDeps)/OTKMath/OpenTK.Mathematics.csproj" />
    <ProjectReference Include="$(LocalDeps)/SDCStub/System.Drawing.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(LocalDeps)'==''">
    <PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parametric3D.UiChecks" />
  </ItemGroup>

</Project>
