<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Кнопки панелей: плоские, подсветка при наведении, без рамки. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource P3.Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource P3.HoverBg}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource P3.PressedBg}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="ToggleButton.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource P3.Text}" />
  </Style>
  <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource P3.HoverBg}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource P3.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource P3.Text}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource P3.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource P3.Text}" />
  </Style>
  <!-- k98 (замечание 12): всплывающие подсказки обрезались на последней букве («Revolv») — округление ширины текста при
       дробном масштабе экрана; запас справа и перенос длинных строк -->
  <!-- k121 (замечание 27.10, 17:27, п. 1): подсказки — В ОДНУ СТРОКУ, без переноса и без предела ширины. С переносом окно
       подсказки (отдельное окно ОС) при дробном масштабе экрана получало ширину на долю пикселя меньше измеренной: текст
       переносился ещё раз, а высота оставалась прежней — последняя строка обрезалась. Без переноса этого не бывает; запас
       справа и снизу покрывает округление. -->
  <Style Selector="ToolTip">
    <Setter Property="Padding" Value="8,5,8,5" />
    <Setter Property="MaxWidth" Value="100000" />
    <Setter Property="MaxHeight" Value="100000" />
  </Style>
  <Style Selector="ToolTip TextBlock">
    <Setter Property="Padding" Value="0,0,8,2" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource P3.TextDim}" />
  </Style>
  <Style Selector="TextBlock.header">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource P3.TextDim}" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource P3.PanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource P3.Border}" />
  </Style>
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{DynamicResource P3.OverlayBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource P3.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- панель инструментов в полосе над видом (12:28): рамка группы, без тени и скругления оверлея -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource P3.PanelBg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource P3.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector="ToggleButton.eye /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.eye:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource P3.HoverBg}" />
  </Style>
  <Style Selector="ToggleButton.eye:unchecked">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="TextBlock.err">
    <Setter Property="Foreground" Value="{DynamicResource P3.Error}" />
  </Style>
  <Style Selector="TextBlock.dimmed">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
</Styles>
