<?xml version="1.0" encoding="utf-8"?>
<!-- Источник пакетов для обычной сборки проверок. Для сборки без сети: -p:LocalDeps=<каталог> (см. Directory.Build.props). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
