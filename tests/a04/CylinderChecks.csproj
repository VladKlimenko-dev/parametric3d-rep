<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/Kernel/**/*.cs" /><Compile Include="$(SourceRoot)/Core/*.cs" />
    <Compile Include="$(SourceRoot)/Model/**/*.cs" /><Compile Include="Program.cs" />
  </ItemGroup>
</Project>
